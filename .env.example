# ==============================================================================
# Revenue Recovery Brain — Central Environment Configuration
# ==============================================================================

# Database Connection URL (Supports PostgreSQL 15 asyncpg or localized SQLite async fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/revenue_recovery

# SQLite Mutex Database Path (Isolated solely for file-level atomic idempotency lease locking)
SQLITE_MUTEX_PATH=./idempotency_store.db

# Application Environment Mode ('development', 'staging', or 'production')
APP_ENV=development

# Server Port (Default: 8000 for FastAPI backend)
PORT=8000

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Credentials (Test Mode Sandbox)
# ------------------------------------------------------------------------------
# Razorpay API Key ID (e.g. rzp_test_xxxxxxxxxxxxxx)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Razorpay API Key Secret
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret

# Razorpay Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ------------------------------------------------------------------------------
# Telephony & Voice Notification Gateway (Twilio / Vapi)
# ------------------------------------------------------------------------------
# Twilio Account SID for outbound conversational telephony
TWILIO_ACCOUNT_SID=placeholder_twilio_account_sid

# Twilio Auth Token for API authentication
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token

# Twilio Outbound Caller ID Phone Number (+1... or +91...)
TWILIO_FROM_NUMBER=+15551234567

# Optional Vapi API Key for cloud voice agent integration
VAPI_API_KEY=placeholder_vapi_api_key

# Optional Vapi Phone Number ID
VAPI_PHONE_NUMBER_ID=placeholder_vapi_phone_number_id

# ------------------------------------------------------------------------------
# LLM & Local Inference Gateway (Ollama / Anthropic)
# ------------------------------------------------------------------------------
# Local Ollama / vLLM server endpoint URL
LLM_SERVER_URL=http://localhost:11434

# Model identifier for unstructured root-cause diagnosis
LLM_DIAGNOSIS_MODEL=mistral:7b-instruct-q4_K_M

# Model identifier for colloquial Hinglish conversational negotiation
LLM_DIALOGUE_MODEL=llama3:8b-instruct-q4_K_M

# LLM inference request timeout budget in seconds
LLM_TIMEOUT_SECONDS=8.0

# Optional Anthropic API Key for fallback cloud reasoning chain
ANTHROPIC_API_KEY=sk-ant-placeholder_api_key

# ------------------------------------------------------------------------------
# Regulatory & Financial Autonomy Policy Thresholds
# ------------------------------------------------------------------------------
# Bank circuit breaker failure trip threshold (< 30% success rate trips the breaker)
OUTAGE_THRESHOLD=0.30

# Maximum autonomous single-transaction recovery cap in normal mode (in INR)
AUTONOMY_MAX_AMOUNT_NORMAL=25000.0

# Contracted autonomous recovery cap during bank rail outages or error spikes (in INR)
AUTONOMY_MAX_AMOUNT_CONTRACTED=5000.0

# Minimum Expected Net Recoverable Value (ENRV) required to trigger outreach (in INR)
ECONOMIC_FLOOR_INR=100.0

# High-stakes intervention threshold requiring human approval before dispatch (in INR)
HIGH_STAKES_THRESHOLD_INR=50000.0

# Maximum permitted outbound voice recovery attempts per debtor per week (RBI limit)
MAX_VOICE_CALLS_PER_WEEK=2

# Maximum permitted digital nudges (WhatsApp/SMS) per debtor per week
MAX_DIGITAL_NUDGES_PER_WEEK=3

# Mandatory quiet cooling-off period in hours after a debtor disputes or complains
DISPUTE_COOLDOWN_HOURS=48
