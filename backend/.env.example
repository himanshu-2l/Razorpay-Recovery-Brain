# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (for LLM reasoning chain)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Vapi (for Hinglish voice agent)
VAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
VAPI_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# App
DATABASE_URL=sqlite+aiosqlite:///./recovery_brain.db
APP_ENV=development

# ── GPU Server (Ollama) ─────────────────────────────────────────────────────
# Set this to your on-prem Ubuntu GPU server's IP/hostname
# Default: localhost (if running Ollama on the same machine)
LLM_SERVER_URL=http://192.168.x.x:11434

# Models to use (must be pulled on the Ollama server)
LLM_DIAGNOSIS_MODEL=mistral:7b-instruct-q4_K_M
LLM_DIALOGUE_MODEL=llama3:8b-instruct-q4_K_M

# Timeout in seconds per LLM call (increase if GPU is slow)
LLM_TIMEOUT_SECONDS=8.0
